{
  "name": "tensorcad",
  "private": true,
  "version": "0.1.0",
  "description": "Schematic capture for neural network architectures",
  "workspaces": [
    "packages/*",
    "desktop/frontend"
  ],
  "scripts": {
    "test": "bun run build:wasm && bun test --timeout 30000 packages",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "build:mcpb": "bun run scripts/build-mcpb.ts --check",
    "build:dist": "bun run scripts/build-dist.ts --check",
    "screenshots": "bun run scripts/screenshots.ts",
    "test:go": "cd packages/core-go && go test ./... && cd ../../desktop && go test ./...",
    "test:all": "bun run typecheck && bun run test && bun run test:go",
    "golden": "cd packages/core-go && go run ./cmd/golden",
    "typecheck": "bun run typecheck:engine && bun run typecheck:cli && bun run typecheck:mcp && bun run typecheck:ui",
    "typecheck:engine": "tsc -p packages/engine/tsconfig.json --noEmit",
    "typecheck:cli": "tsc -p packages/cli/tsconfig.json --noEmit",
    "typecheck:mcp": "tsc -p packages/mcp/tsconfig.json --noEmit",
    "typecheck:ui": "node packages/ui/scripts/typecheck.mjs",
    "cli": "bun run packages/cli/src/index.ts",
    "ui": "cd packages/ui && bun run dev",
    "report": "bun run scripts/report.ts",
    "codegen": "bun run scripts/codegen-demo.ts",
    "desktop": "cd desktop && wails3 dev",
    "desktop:build": "cd desktop && wails3 build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=20"
  }
}
