{
  "name": "tensorcad",
  "private": true,
  "version": "0.0.0",
  "description": "Schematic capture for neural network architectures",
  "workspaces": [
    "packages/*",
    "desktop/frontend"
  ],
  "scripts": {
    "test": "bun run build:wasm && bun test packages",
    "build:wasm": "bun run scripts/build-wasm.ts",
    "build:mcpb": "bun run scripts/build-mcpb.ts --check",
    "test:go": "cd packages/core-go && go test ./... && cd ../../desktop && go test ./...",
    "test:all": "bun run typecheck && bun run test && bun run test:go",
    "golden": "cd packages/core-go && go run ./cmd/golden",
    "typecheck": "tsc -p packages/engine/tsconfig.json --noEmit",
    "cli": "bun run packages/cli/src/index.ts",
    "ui": "cd packages/ui && bun run dev",
    "report": "bun run scripts/report.ts",
    "codegen": "bun run scripts/codegen-demo.ts",
    "desktop": "cd desktop && wails3 dev",
    "desktop:build": "cd desktop && wails3 build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
