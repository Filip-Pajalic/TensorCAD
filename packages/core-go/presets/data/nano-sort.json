{
  "version": 1,
  "meta": {
    "name": "nano-sort",
    "family": "toy",
    "notes": "A transformer small enough to look at: three layers of width 48, three heads of 16, and a vocabulary of three tokens. It is the model in Karpathy's minGPT sorting demo and in Brendan Bycroft's LLM visualisation, and its structure is GPT-2's exactly — learned positions, LayerNorm with bias, a GELU feed-forward, causal attention, an untied head. Everything a 405B model does, at a size where every weight fits on the screen at a readable zoom. The 85,728 is a figure this repository computed and checked against PyTorch rather than one a vendor published; the visualisation's 85,584 is the same model counted without its output projection.",
    "published": {
      "params": 85728,
      "source": "https://github.com/karpathy/minGPT/blob/master/demo.ipynb"
    }
  },
  "symbols": {
    "B": {
      "kind": "runtime",
      "default": 1,
      "doc": "Batch size"
    },
    "T": {
      "kind": "runtime",
      "default": 11,
      "doc": "Sequence length in tokens"
    },
    "L": {
      "kind": "design",
      "value": 3,
      "doc": "Number of transformer layers"
    },
    "D": {
      "kind": "design",
      "value": 48,
      "doc": "Residual stream width (d_model)"
    },
    "H": {
      "kind": "design",
      "value": 3,
      "doc": "Query heads"
    },
    "Hkv": {
      "kind": "design",
      "value": 3,
      "doc": "Key/value heads"
    },
    "dh": {
      "kind": "design",
      "value": 16,
      "doc": "Head dimension"
    },
    "F": {
      "kind": "design",
      "value": "4*D",
      "doc": "Feed-forward hidden width"
    },
    "V": {
      "kind": "design",
      "value": 3,
      "doc": "Vocabulary size: three symbols, A, B and C"
    },
    "Tmax": {
      "kind": "design",
      "value": 11,
      "doc": "Maximum position index: six to read and five to write"
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "tokens",
        "type": "input",
        "params": {
          "shape": "B T",
          "dtype": "int64"
        }
      },
      {
        "id": "embed",
        "type": "embedding",
        "params": {
          "vocab": "V",
          "dim": "D"
        }
      },
      {
        "id": "pos",
        "type": "pos_embedding",
        "params": {
          "max_seq": "Tmax",
          "dim": "D"
        }
      },
      {
        "id": "layers",
        "type": "repeat",
        "label": "Transformer block x3",
        "params": {
          "count": "L"
        },
        "graph": {
          "nodes": [
            {
              "id": "_in",
              "type": "boundary_in",
              "params": {
                "ports": {
                  "x": "B T D"
                }
              }
            },
            {
              "id": "block",
              "type": "transformer_block",
              "params": {
                "d_model": "D",
                "heads": "H",
                "kv_heads": "Hkv",
                "head_dim": "dh",
                "ffn_hidden": "F",
                "norm": "layernorm",
                "norm_bias": true,
                "post_norm": false,
                "mlp": "dense",
                "act": "gelu",
                "attn_bias": true,
                "attn_o_bias": null,
                "mlp_bias": true,
                "qk_norm": false,
                "causal": true,
                "window": 0,
                "rope": null
              }
            },
            {
              "id": "_out",
              "type": "boundary_out",
              "params": {
                "ports": {
                  "x": "B T D"
                }
              }
            }
          ],
          "edges": [
            [
              "_in:x",
              "block:x"
            ],
            [
              "block:y",
              "_out:x"
            ]
          ]
        }
      },
      {
        "id": "final_norm",
        "type": "layernorm",
        "params": {
          "dim": "D",
          "bias": true
        }
      },
      {
        "id": "head",
        "type": "lm_head",
        "params": {
          "vocab": "V",
          "dim": "D",
          "tied": false
        }
      },
      {
        "id": "logits",
        "type": "output"
      }
    ],
    "edges": [
      [
        "tokens:x",
        "embed:ids"
      ],
      [
        "embed:y",
        "pos:x"
      ],
      [
        "pos:y",
        "layers:x"
      ],
      [
        "layers:x",
        "final_norm:x"
      ],
      [
        "final_norm:y",
        "head:x"
      ],
      [
        "head:y",
        "logits:x"
      ]
    ]
  },
  "ui": {}
}
