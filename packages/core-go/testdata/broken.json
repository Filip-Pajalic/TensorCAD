          "rule": "shape",
          "severity": "error",
          "path": "rope",
          "message": "RoPE needs an even head_dim, got 33"
        },
        {
          "rule": "ROPE-01",
          "severity": "error",
          "path": "rope",
          "param": "head_dim",
          "message": "RoPE needs an even head_dim, got 33",
          "hint": "Rotary embedding rotates pairs of channels, so an odd width leaves one unpaired."
        },
        {
          "rule": "shape",
          "severity": "error",
          "path": "rope",
          "port": "x",
          "message": "Input port \"x\" is not connected"
