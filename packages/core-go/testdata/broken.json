          "rule": "dangling-output",
          "severity": "warning",
          "path": "rope",
          "port": "y",
          "message": "Output \"y\" is not connected to anything.",
          "hint": "Connect it downstream or delete the block."
        },
        {
          "rule": "logits-memory",
          "severity": "info",
          "message": "The logits buffer is 749.25 KiB, which is 83% of all activation memory.",
          "hint": "Compute the cross-entropy in chunks over the sequence so the full logits tensor is never materialized."
        },
        {
          "rule": "unused-symbol",
          "severity": "info",
          "message": "Symbol \"Unused\" is not referenced by any block.",
          "hint": "Remove it, or wire it into the parameter that should follow it."
        },
        {
          "rule": "window-vs-context",
          "severity": "info",
          "path": "attn",
          "message": "The 4096-token sliding window is at least as wide as the 128-token context, so it has no effect here.",
          "hint": "Analyse at a longer context to see what the window buys."
        },
        {
          "rule": "vocab-padding",
          "severity": "info",
          "path": "head",
          "message": "Vocabulary 999 is not a multiple of 128.",
          "hint": "Padding to 1024 adds 2.5K parameters and speeds up the output projection."
        },
        {
          "rule": "tensor-core-multiples",
          "severity": "info",
          "path": "wide",
          "message": "Projection width 100 is not a multiple of 64.",
          "hint": "Rounding up to 128 usually costs little memory and speeds up the matmul."
        },
        {
          "rule": "tensor-core-multiples",
          "severity": "info",
          "path": "wide",
          "message": "Projection width 300 is not a multiple of 64.",
          "hint": "Rounding up to 320 usually costs little memory and speeds up the matmul."
        }
      ]
