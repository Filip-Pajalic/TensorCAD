      "findings": [
        {
          "rule": "shape",
          "severity": "error",
          "path": "attn",
          "message": "heads (3) must be divisible by kv_heads (2)"
        },
        {
          "rule": "SDPA-01",
          "severity": "error",
          "path": "attn",
          "param": "kv_heads",
          "message": "heads (3) must be divisible by kv_heads (2)"
        },
        {
