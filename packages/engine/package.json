{
  "name": "@tensor-cad/engine",
  "version": "0.1.7",
  "description": "The TensorCAD analysis engine, compiled from Go to WebAssembly, with its TypeScript client",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./wasm_exec": "./vendor/wasm_exec.js",
    "./tensorcad.wasm": "./wasm/tensorcad.wasm"
  },
  "files": [
    "src",
    "vendor",
    "wasm"
  ],
  "scripts": {
    "build": "bun run ../../scripts/build-wasm.ts",
    "test": "bun test ../../packages/engine/test",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "sideEffects": [
    "./vendor/wasm_exec.js"
  ]
}
